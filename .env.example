# 复制为 .env 后填写（不要提交 .env）
# cp .env.example .env

# ---- tg-worker（TG-JIQIREN）必填 ----
TG_ENV=production
TG_ADMIN_API_KEY=请填写一段长随机字符串
TG_OPERATOR_API_KEY=请填写另一段长随机字符串
TG_API_ID=请填写数字（https://my.telegram.org 申请）
TG_API_HASH=请填写

# ---- 可选：AI 文案/自动回复（OpenAI 兼容接口） ----
# TG_AI_API_KEY=
# TG_AI_BASE_URL=https://api.openai.com/v1
# TG_AI_MODEL=gpt-4o-mini
