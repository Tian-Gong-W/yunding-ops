# Runtime environment: development or production
# Keep this example safe to copy. Production should be enabled explicitly.
TG_ENV=development

# Generate long random values; never commit the real values.
TG_ADMIN_API_KEY=replace-with-a-long-random-admin-key
TG_OPERATOR_API_KEY=replace-with-a-long-random-operator-key

# Telegram application credentials from https://my.telegram.org
TG_API_ID=replace-with-telegram-api-id
TG_API_HASH=replace-with-telegram-api-hash

# Local development only. Production rejects this setting.
TG_AUTH_DISABLED=false

# Optional database path. Prefer a path outside the Git working tree.
# TG_DB_PATH=/secure/path/tg_data.db

# Session archive safety limits
TG_MAX_SESSION_UPLOAD_BYTES=209715200
TG_MAX_SESSION_ZIP_MEMBERS=2000
TG_MAX_SESSION_EXTRACTED_BYTES=536870912

# OpenAI-compatible AI copy generation. Do not commit a real key.
# Examples: OpenAI https://api.openai.com/v1; DeepSeek https://api.deepseek.com/v1
TG_AI_PROVIDER=OpenAI-compatible
TG_AI_BASE_URL=https://api.openai.com/v1
TG_AI_MODEL=gpt-4o-mini
TG_AI_API_KEY=replace-with-ai-api-key

# Mistral Agents mode: set TG_AI_PROVIDER=mistral_conversations
# TG_AI_BASE_URL=https://api.mistral.ai/v1
# TG_AI_AGENT_ID=ag_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TG_AI_AGENT_VERSION=1
# MISTRAL_API_KEY=replace-with-mistral-api-key
